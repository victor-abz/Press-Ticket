NODE_ENV=production

# Nome da Empresa
COMPANY_NAME=pressticket
DEVICE_NAME=pressticket

# URLs e Portas
BACKEND_URL=http://localhost
FRONTEND_URL=http://localhost:3000
WEBHOOK=http://localhost:8080
PORT=8080
PROXY_PORT=8080

# Caminho do Chrome
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux: /usr/bin/google-chrome-stable
# Docker: /usr/bin/chromium-browser
CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe

# Dados de acesso ao Banco de dados
DB_DIALECT=mysql
DB_HOST=localhost
DB_TIMEZONE=-03:00
DB_USER=root
DB_PASS=
DB_NAME=press-ticket

# Limitar Usuários e Conexões
USER_LIMIT=3
CONNECTIONS_LIMIT=1

# Modo DEMO que evita alterar algumas funções, para ativar: ON
DEMO=OFF

#Credenciais do Email para o Nodemailer
EMAIL_USER=seu.email@gmail.com
EMAIL_PASS=suasenha

PM2_FRONTEND=0
PM2_BACKEND=1

# Gere valores únicos com: openssl rand -base64 32
JWT_SECRET=SUBSTITUA_POR_VALOR_ALEATORIO_1
JWT_REFRESH_SECRET=SUBSTITUA_POR_VALOR_ALEATORIO_2

# Chave para criptografia de secrets no banco (AES-256-GCM)
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=SUBSTITUA_POR_VALOR_HEX_64_CHARS

# Segredo do webhook do NotificameHub — a API do NotificameHub não suporta
# assinatura HMAC nem headers customizados nas subscriptions (apenas a URL),
# então o segredo é embutido como query param na URL do webhook e validado
# em tempo constante em cada callback recebido.
# Gere com: openssl rand -hex 32
# Após alterar, re-registre as subscriptions do canal (endpoint resubscribe)
# para que o NotificameHub passe a chamar a URL com o novo token.
HUB_WEBHOOK_SECRET=SUBSTITUA_POR_VALOR_HEX_64_CHARS

# Telemetria Anônima (true para habilitar, false para desabilitar)
ALLOW_TELEMETRY=true
